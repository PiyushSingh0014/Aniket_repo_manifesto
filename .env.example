# Where the suggestion form sends its JSON. Formspree, Web3Forms or a Google Apps Script web app URL.
VITE_FORM_ENDPOINT=

# Web3Forms only: your access key (it is designed to be public). Leave empty for Formspree or Apps Script.
VITE_FORM_ACCESS_KEY=

# Optional: your custom domain, used for absolute link-preview URLs. Vercel's production URL is used if empty.
VITE_SITE_URL=
